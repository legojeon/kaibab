{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.2.0",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.kaist.ac.kr/*"
  ],
  "action": {
    "default_title": "__MSG_extensionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; object-src 'none'; connect-src https://www.kaist.ac.kr/kr/html/campus/053001.html https://www.kaist.ac.kr/en/html/campus/053001.html; img-src 'self'; style-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'"
  },
  "default_locale": "en"
}
